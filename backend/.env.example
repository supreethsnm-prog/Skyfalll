DATABASE_URL=postgresql+psycopg://weathergpt:weathergpt_dev@127.0.0.1:5432/weathergpt
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# auto | anthropic | gemini  (auto picks whichever API key is configured)
LLM_PROVIDER=auto

# Background ingestion scheduler — OFF by default. The test suite constructs
# TestClient(app) in many files, which triggers FastAPI's lifespan events;
# leaving this off by default means test runs never spawn real background
# threads hitting real external APIs. Set to true only when actually running
# the server (locally or deployed) and you want alerts/marine data to refresh
# automatically instead of only via the manual /internal/ingest/* endpoints.
# Note: each job fires immediately on startup (by design), in addition to its
# regular interval. Running with `uvicorn --reload` and ENABLE_SCHEDULER=true
# together means every file save (reload) triggers an immediate SACHET +
# INCOIS fetch — worth knowing before enabling this for casual local dev
# against feeds with undocumented rate limits.
ENABLE_SCHEDULER=false
ALERT_INGESTION_INTERVAL_SECONDS=300
MARINE_INGESTION_INTERVAL_SECONDS=86400

# Shared secret required on X-Internal-API-Key for POST /internal/ingest/*.
# Left blank, these endpoints stay open (today's behavior) but log a
# warning on every request — set this before any real deployment or demo
# where the backend is reachable by anyone other than you.
INTERNAL_API_KEY=

# Comma-separated list of origins allowed to call this API from a browser.
# Defaults cover common local frontend dev ports; override for a real
# deployment. No CORS credentials are enabled — this API has no
# cookie-based auth, so there's nothing that needs them.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# BHASHINI (ULCA) voice + translation — STT/TTS/NMT.
# Discovery header `ulcaApiKey` = BHASHINI_API_KEY (legacy alias
# BHASHINI_UDYAT_KEY accepted — UDYAT is the ULCA dashboard name).
# BHASHINI_INFERENCE_KEY is the SEPARATE Dhruva compute token returned by
# discovery (usually header `Authorization`) — never send it as `ulcaApiKey`
# or discovery fails with `400 ulcaApiKey does not exist`.
# BHASHINI_PIPELINE_ID defaults to MeitY's public multitask pipeline
# (ASR+NMT+TTS, 22 scheduled languages + English). Override for a custom
# pipeline. Until USER_ID + API_KEY are set, voice/translate endpoints
# return a clear 503, the same way /chat does with no LLM key configured.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Legacy alias for BHASHINI_API_KEY — either one works, API_KEY wins.
BHASHINI_UDYAT_KEY=
BHASHINI_INFERENCE_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
